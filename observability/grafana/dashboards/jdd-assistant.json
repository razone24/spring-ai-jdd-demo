    {
      "type": "stat",
      "title": "LLM answer p95",
      "description": "95th percentile latency of answers that went through the LLM (cache hits excluded).",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
