            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(percentile_cont(0.95) within group (order by latency_ms),0) from query_audit where not cache_hit and $__timeFilter(created_at)"
        }
