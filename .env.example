# Copy to .env (git-ignored) — every value is optional.

# Web search MCP server (https://tavily.com). Without it, searchWeb answers "not configured" and the
# assistant says the web is unavailable.
TAVILY_API_KEY=

# Ollama. Default: Ollama running natively on the host (Metal GPU on a Mac).
# For the containerised one: docker compose --profile ollama up -d  and  OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# EMBEDDING_MODEL=nomic-embed-text

# Swap the agent's LLM to any OpenAI-compatible API — same code, one property.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Pin "today" (e.g. to day 2 of the conference) so "what's on after lunch today?" works during rehearsals.
# ASSISTANT_TODAY=2026-10-21

# Minimum similarity (0..1) for the semantic cache to answer without the LLM, and how long a cached answer is trusted.
# ASSISTANT_CACHE_HIT_THRESHOLD=0.9
# ASSISTANT_CACHE_MAX_AGE=24h
