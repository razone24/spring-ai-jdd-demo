# Copy to .env (git-ignored) — every value is optional except the OpenAI key when running on OpenAI.

# Web search MCP server (https://tavily.com). Without it, searchWeb answers "not configured" and the
# assistant says the web is unavailable.
TAVILY_API_KEY=

# LLM provider for chat and embeddings in every AI service: openai (default) or ollama.
# If the selected provider isn't usable, each AI service stops at startup with a clear message.
# LLM_PROVIDER=openai
# Skip the startup network check of the provider (the OpenAI key must still be set).
# LLM_VERIFY_CONNECTIVITY=true

# OpenAI (default provider).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# An OpenAI-compatible API works only if it also serves text-embedding-3-small with the `dimensions` option.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama (LLM_PROVIDER=ollama). Default: Ollama running natively on the host (Metal GPU on a Mac).
# For the containerised one: docker compose --profile ollama up -d  and  OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Pin "today" (e.g. to day 2 of the conference) so "what's on after lunch today?" works during rehearsals.
# ASSISTANT_TODAY=2026-10-21

# Similarity thresholds. Defaults depend on the provider (openai 0.8 / ollama 0.9 for a cache hit;
# openai 0.4 / ollama 0.5 for returning cache candidates), because embedding models score differently.
# ASSISTANT_CACHE_HIT_THRESHOLD=0.9
# CHAT_HISTORY_SIMILARITY_THRESHOLD=0.5
# ASSISTANT_CACHE_MAX_AGE=24h
